# ====== Server ======
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ====== MongoDB ======
# Create a free cluster at https://cloud.mongodb.com, then paste its SRV URI here.
# It will look like: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/careercopilot
MONGODB_URI=

# ====== Auth (Phase 1) ======
# Use any long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
COOKIE_SECRET=

# ====== Groq (AI provider) ======
# Get a free key at https://console.groq.com/keys
# Powers resume analysis, JD match, question answers, prep plan, interview chat.
GROQ_API_KEY=

# ====== Cloudinary (Phase 2+) ======
# Create a free account at https://cloudinary.com, copy values from your dashboard.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ====== OAuth (optional — leave blank to disable a provider) ======
# Google: https://console.cloud.google.com → APIs & Services → Credentials →
#   Create OAuth client ID → Web application
#   Authorized redirect URI: http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LinkedIn: https://www.linkedin.com/developers/apps → Create app →
#   Add the "Sign In with LinkedIn using OpenID Connect" product
#   Authorized redirect URL: http://localhost:4000/api/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public URLs for OAuth callbacks and post-login redirects.
# Local dev: defaults below.
# Vercel + Render (vercel.json rewrites /api to Render):
#   PUBLIC_APP_URL=https://your-app.vercel.app
#   PUBLIC_API_URL=https://your-app.vercel.app   ← same as app (not the Render URL)
#   CORS_ORIGIN=https://your-app.vercel.app
#   Do NOT set VITE_API_URL on Vercel — leave it unset so /api stays same-origin.
#   Register OAuth redirect URIs as https://your-app.vercel.app/api/auth/<provider>/callback
PUBLIC_API_URL=http://localhost:4000
PUBLIC_APP_URL=http://localhost:5173
