# Leave unset in local dev — Vite proxies /api → http://localhost:4000
#
# Vercel + Render: leave UNSET on Vercel. vercel.json rewrites /api to Render so
# auth cookies stay first-party on your Vercel domain (cross-site cookies to
# *.onrender.com are blocked in modern browsers).
#
# Only set this if the SPA and API share one origin (no separate Vercel frontend):
# VITE_API_URL=https://your-api.onrender.com
